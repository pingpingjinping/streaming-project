# Local PostgreSQL container settings
POSTGRES_DB=anime
POSTGRES_USER=anime
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Keep login sessions stable across restarts/rebuilds
AUTH_SECRET=replace-with-a-long-random-secret

# Optional: override the Linkani mirror/base URL (legacy setting name) when needed
# LINKKF_BASE_URL=https://linkani.tv
